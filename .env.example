# SportBook Pro Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# ENVIRONMENT SETTINGS
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE CONFIGURATION (Required)
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/sports_booking

# ============================================
# SESSION CONFIGURATION (Required)
# ============================================
# Strong secret key for session encryption (min 32 characters)
SESSION_SECRET=your-super-secret-session-key-at-least-32-characters

# ============================================
# FIREBASE CONFIGURATION (Optional)
# ============================================
# For push notifications - get from Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================

# Redis for production sessions
REDIS_URL=redis://localhost:6379

# Email service for notifications
EMAIL_SERVICE_KEY=your-email-service-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# SMS service for OTP/notifications
SMS_SERVICE_KEY=your-sms-service-key

# Payment gateway
PAYMENT_GATEWAY_KEY=your-payment-gateway-key
PAYMENT_GATEWAY_SECRET=your-payment-gateway-secret

# File storage (AWS S3, etc.)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket-name

# ============================================
# MONITORING & LOGGING (Optional)
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Sentry for error tracking
SENTRY_DSN=your-sentry-dsn

# Application monitoring
APM_SERVICE_NAME=sportbook-pro
APM_SERVER_URL=your-apm-server-url

# ============================================
# SECURITY SETTINGS (Production)
# ============================================
# CORS origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_PAYMENT_GATEWAY=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=true

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Only for development - remove in production
DEBUG=true
MOCK_PAYMENT_GATEWAY=true
SKIP_EMAIL_VERIFICATION=true

# ============================================
# DOCKER SETTINGS (For docker-compose)
# ============================================
DB_PASSWORD=sportbook123
COMPOSE_PROJECT_NAME=sportbook

# ============================================
# EXAMPLE VALUES
# ============================================
# Here are some example configurations:

# Example for Supabase:
# DATABASE_URL=postgresql://postgres.xyz:password@db.abc.supabase.co:5432/postgres

# Example for Neon:
# DATABASE_URL=postgresql://username:password@ep-xyz.us-east-1.aws.neon.tech/neondb

# Example for Railway:
# DATABASE_URL=postgresql://postgres:password@containers-us-west-xyz.railway.app:1234/railway

# Example for local PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/sports_booking

# ============================================
# NOTES
# ============================================
# 1. Never commit .env file to version control
# 2. Use strong passwords and secrets
# 3. Rotate secrets regularly in production
# 4. Consider using environment-specific configs
# 5. Validate all environment variables on startup
